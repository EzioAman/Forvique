{
  "name": "harness-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "app": "vite build && electron .",
    "dist": "tsc -b && vite build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "exceljs": "^4.4.0",
    "leaflet": "^1.9.4",
    "mammoth": "^1.13.0",
    "unpdf": "^2.1.0"
  },
  "devDependencies": {
    "@assistant-ui/react": "^0.15.33",
    "@assistant-ui/react-devtools": "^1.2.27",
    "@assistant-ui/react-langgraph": "^0.14.38",
    "@assistant-ui/react-markdown": "^0.14.25",
    "@assistant-ui/react-streamdown": "^0.3.21",
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@langchain/langgraph-sdk": "^1.15.0",
    "@streamdown/code": "^2.0.0",
    "@streamdown/math": "^1.0.3",
    "@tailwindcss/vite": "^4.3.5",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "katex": "^0.19.1",
    "lucide-react": "^1.70.0",
    "next-themes": "^0.4.6",
    "oxlint": "^1.90.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.23.0",
    "streamdown": "^2.7.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "tw-shimmer": "^0.4.14",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "zustand": "^5.1.0"
  },
  "productName": "Harness",
  "description": "Harness desktop client",
  "author": "Forvique",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.forvique.harness",
    "productName": "Harness",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Harness-Setup-${version}.exe"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    }
  }
}
